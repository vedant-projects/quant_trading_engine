APP_NAME=Personal Quant Trading Engine
APP_ENV=development

# Paper trading only at this stage
IS_PAPER=true
ENABLE_LIVE_TRADING=false

DATABASE_URL=postgresql+asyncpg://quant:CHANGE_ME@127.0.0.1:5432/quant_engine
REDIS_URL=redis://127.0.0.1:6379/0

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5.0
DATABASE_HEALTH_TIMEOUT_SECONDS=3.0

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

MAX_DAILY_LOSS_PCT=2.0
MAX_POSITION_PCT=10.0

LOG_LEVEL=INFO